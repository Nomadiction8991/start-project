# Nome app
# Regra: minusculo, sem espaco, usar "-" no lugar de separadores
APP_NAME=start-project

# Usuario host
# Vazio = usa UID/GID do host automaticamente
LOCAL_UID=
LOCAL_GID=

# App
# `make up` sobe a primeira porta livre a partir daqui
HOST_PORT=8080
APP_ENV=local

# Banco
# `make up` sobe a primeira porta livre a partir daqui
DB_HOST=db
DB_PORT=3306
DB_DATABASE=${APP_NAME}
DB_ROOT_PASSWORD=password

# Redis
# `make up` sobe a primeira porta livre a partir daqui
REDIS_HOST=redis
REDIS_PORT=6379

# Vite
# `make up` sobe a primeira porta livre a partir daqui
VITE_PORT=5173
# dev = servidor HMR em background | build = build único antes do Apache
VITE_ENV=dev
